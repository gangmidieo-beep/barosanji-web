{
  "name": "farm-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "find .next/cache -mindepth 1 -delete 2>/dev/null; find node_modules/.cache -mindepth 1 -delete 2>/dev/null; rm -rf .next/server .next/static 2>/dev/null; true",
    "build": "next build",
    "start": "tsx src/db/migrate.ts && tsx src/db/seed.ts && next start",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
